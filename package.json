{
  "name": "@systembootstrapper/wizard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "npm run docs:check && npm run typecheck && vite build",
    "docs:compile": "node scripts/compile-docs-locales.mjs",
    "docs:check": "node scripts/compile-docs-locales.mjs --check && node --test tests/offline/docs-locales.test.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "playwright test",
    "lint": "eslint .",
    "eslint": "eslint .",
    "build:config-export": "rolldown scripts/export-configuration.ts --platform node --format cjs --file build-tools/export-configuration.cjs --no-codeSplitting",
    "test:config-export": "npm run build:config-export && node --test tests/offline/export-configuration.test.cjs",
    "test:delivery": "node --test tests/offline/delivery-recipe.test.cjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "file-saver": "2.0.5",
    "i18next": "27.0.1",
    "jszip": "3.10.2",
    "md5": "2.3.0",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "moment": "2.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.2",
    "remark-gfm": "4.0.1",
    "tss-react": "4.9.21",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/file-saver": "2.0.7",
    "@types/md5": "2.3.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "rolldown": "1.2.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
