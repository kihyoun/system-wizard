{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "dependencyDashboardApproval": true,
  "automerge": false,
  "platformAutomerge": false,
  "ignoreUnstable": true,
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "enabledManagers": [
    "npm",
    "dockerfile",
    "docker-compose",
    "gitlabci",
    "custom.regex"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/fixtures/**"
  ],
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "dependencyDashboardApproval": true,
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Keep supported Node and CI runtime on their reviewed major lines.",
      "matchPackageNames": [
        "node"
      ],
      "allowedVersions": "/^24\\./"
    },
    {
      "description": "GitLab and Runner require the reviewed paired migration workflow.",
      "matchPackageNames": [
        "gitlab/gitlab-ce",
        "gitlab/gitlab-ee",
        "gitlab/gitlab-runner",
        "registry.gitlab.com/gitlab-org/gitlab-runner/gitlab-runner-helper"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "compatible npm dependencies",
      "groupSlug": "npm-compatible"
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "gitlabci",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "compatible runtime images",
      "groupSlug": "runtime-compatible"
    },
    {
      "description": "Keep Docker client and daemon on the reviewed major.",
      "matchPackageNames": [
        "docker"
      ],
      "allowedVersions": "/^29\\./"
    },
    {
      "description": "Refresh pinned Renovate within its reviewed stable major.",
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "allowedVersions": "/^44\\./"
    }
  ],
  "customManagers": [],
  "vulnerabilityAlerts": {
    "dependencyDashboardApproval": true,
    "automerge": false,
    "platformAutomerge": false
  }
}
